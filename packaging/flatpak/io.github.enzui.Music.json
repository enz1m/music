{
  "app-id": "io.github.enzui.Music",
  "branch": "stable",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "music-app",
  "finish-args": [
    "--socket=wayland",
    "--device=dri",
    "--share=network",
    "--socket=pulseaudio",
    "--talk-name=org.freedesktop.secrets",
    "--filesystem=xdg-music:ro",
    "--own-name=org.mpris.MediaPlayer2.Music"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin"
  },
  "modules": [
    {
      "name": "music",
      "buildsystem": "simple",
      "build-commands": [
        "cargo build --locked --offline --release --jobs \"${FLATPAK_BUILDER_N_JOBS:-2}\" --bin music-app",
        "install -Dm755 target/release/music-app /app/bin/music-app",
        "install -Dm644 assets/io.github.enzui.Music.desktop /app/share/applications/io.github.enzui.Music.desktop",
        "install -Dm644 packaging/flatpak/io.github.enzui.Music.metainfo.xml /app/share/metainfo/io.github.enzui.Music.metainfo.xml",
        "install -Dm644 assets/io.github.enzui.Music.svg /app/share/icons/hicolor/scalable/apps/io.github.enzui.Music.svg",
        "install -Dm644 LICENSE /app/share/licenses/io.github.enzui.Music/LICENSE",
        "install -Dm644 vendor/gst-curl/LICENSE-MIT /app/share/licenses/io.github.enzui.Music/gst-curl/LICENSE-MIT",
        "install -Dm644 vendor/gst-curl/UPSTREAM.json /app/share/licenses/io.github.enzui.Music/gst-curl/UPSTREAM.json"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/enz1m/music.git",
          "commit": "@ENZIM_SOURCE_COMMIT@",
          "disable-submodules": true
        },
        {
          "type": "archive",
